local function WriteAutoload(name)
    if not writefile then return end
    pcall(function()
        writefile(AUTOLOAD_FILE, (name and name ~= "") and name or "off")
    end)
end

local function RefreshConfigList()
    local list = Windows.ListConfigs() or {}
    local out = {}
    for _, c in ipairs(list) do table.insert(out, c) end
    if #out == 0 then out = { "---" } end
    return out
end

