--==================================================
--= SYNC STATE SETELAH LOAD CONFIG
--==================================================

function SyncStateFromToggles()
    local function readVal(ref)
        if not ref then return nil end
        if ref.Value ~= nil then return ref.Value end
        if type(ref.Get) == "function" then
            local ok, v = pcall(ref.Get)
            if ok then return v end
        end
        return nil
    end

    local v

    v = readVal(toggleRefs.EnableAutoFarm)
    if v ~= nil then State.EnableAutoFarm = v end

    v = readVal(toggleRefs.ServerHop)
    if v ~= nil then
        State.ServerHop = v
        if v then task.spawn(ServerHop) end
    end

    v = readVal(toggleRefs.AutoExecute)
    if v ~= nil then
        State.AutoExecute = v
        if v then QueueAutoExec() end
    end

    v = readVal(toggleRefs.EnableWebhook)
    if v ~= nil then State.EnableWebhook = v end
end

--==================================================
--= AUTO LOAD SAAT SCRIPT DIEKSEKUSI (termasuk setelah hop)
--==================================================

task.defer(function()
    task.wait(1.2)
    local name = ReadAutoload()
    if name == "" then
        if autoloadLabel then pcall(function() autoloadLabel.Set("Current autoload config: none") end) end
        return
    end

    local list = Windows.ListConfigs() or {}
    local found = false
    for _, c in ipairs(list) do
        if c == name then found = true; break end
    end

    if found then
        local ok = pcall(function() Windows.LoadConfig(name) end)
        if ok then
            Notify("Autoload", "Loaded: " .. name)
            task.defer(function()
                task.wait(0.3)
                SyncStateFromToggles()
            end)
        else
            Notify("Autoload", "Gagal load: " .. name, 4)
        end
    else
        Notify("Autoload", "Config tidak ditemukan: " .. name, 4)
    end
end)

